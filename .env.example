# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# Primary Document Database (Transactions & Sagas)
DATABASE_URL=mongodb://localhost:27017/transitly

# Slow Path Spatial Telemetry Database (PostgreSQL with PostGIS Extension)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transitly_telemetry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_POOL_MAX=20
POSTGRES_SSL=false

# Fast Path Redis (Pub/Sub, GEO, and Stream Buffer)
REDIS_URL=redis://localhost:6379
REDIS_TELEMETRY_STREAM=stream:telemetry:gps
REDIS_TELEMETRY_GEO_KEY=tracking:positions
REDIS_TELEMETRY_CONSUMER_GROUP=cg:telemetry:durable
REDIS_TELEMETRY_BATCH_SIZE=200
REDIS_TELEMETRY_FLUSH_INTERVAL_MS=1000

# Durable background job queue / event bus
QUEUE_DRIVER=redis
QUEUE_URL=redis://localhost:6379
QUEUE_PREFIX=transitly

# Optional last-mile delivery orchestration
LAST_MILE_ENABLED=false
LAST_MILE_SERVICEABILITY_CACHE_TTL_SECONDS=300
LAST_MILE_QUOTE_TTL_SECONDS=900
LAST_MILE_FALLBACK_REQUIRES_CUSTOMER_CONSENT=true

# Uber Direct (enable only after account and regional production approval)
UBER_DIRECT_ENABLED=false
UBER_DIRECT_CUSTOMER_ID=replace_with_uber_direct_customer_id
UBER_DIRECT_CLIENT_ID=replace_with_uber_direct_client_id
UBER_DIRECT_CLIENT_SECRET=replace_with_uber_direct_client_secret
UBER_DIRECT_WEBHOOK_SIGNING_KEY=replace_with_uber_webhook_signing_key

# Partner providers (keep disabled until API terms and webhook specifications are approved)
RAPIDO_ENABLED=false
RAPIDO_API_BASE_URL=
RAPIDO_API_KEY=
RAPIDO_WEBHOOK_SECRET=
INDRIVE_ENABLED=false
INDRIVE_API_BASE_URL=
INDRIVE_API_KEY=
INDRIVE_WEBHOOK_SECRET=

# Authentication
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_ISSUER_URL=https://identity-provider.example.com
AUTH_AUDIENCE=transitly-api

# Maps, geocoding, and route optimization provider
MAPS_API_KEY=replace_with_maps_provider_key

# GPS / telematics integration
GPS_PROVIDER_API_URL=https://gps-provider.example.com/api
GPS_PROVIDER_API_KEY=replace_with_gps_provider_key
GPS_WEBHOOK_SECRET=replace_with_gps_webhook_secret

# Customer notification providers
EMAIL_FROM=notifications@example.com
EMAIL_API_KEY=replace_with_email_provider_key
SMS_API_KEY=replace_with_sms_provider_key
SMS_SENDER_ID=TRANSITLY

# WhatsApp Business Platform / approved WhatsApp provider
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=replace_with_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=replace_with_whatsapp_access_token
WHATSAPP_APP_SECRET=replace_with_whatsapp_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_random_webhook_verify_token
WHATSAPP_STATUS_TEMPLATE=parcel_status_update
WHATSAPP_SUPPORT_QUEUE_ENABLED=true

# Error reporting and telemetry
OTEL_SERVICE_NAME=transitly-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry-provider.example.com
ERROR_REPORTING_DSN=replace_with_error_reporting_dsn

# Object storage for proof-of-delivery signatures and images
STORAGE_BUCKET=transitly-delivery-evidence
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=replace_with_storage_access_key
STORAGE_SECRET_ACCESS_KEY=replace_with_storage_secret
STORAGE_SIGNED_URL_TTL_SECONDS=900
